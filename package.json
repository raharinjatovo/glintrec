{
  "name": "glintrec",
  "version": "2.0.0",
  "description": "GlintRec - screen recorder with annotations, zoom and webcam",
  "author": "Mbolatiana",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "dist:linux": "npm run build && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "com.glintrec.app",
    "productName": "GlintRec",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!**/node_modules/uiohook-napi/{libuiohook,src}/**"
    ],
    "asarUnpack": [
      "**/node_modules/uiohook-napi/prebuilds/**/*.node"
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "files": [
        "!**/node_modules/uiohook-napi/prebuilds/!(win32-x64)/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "assets/icon.png",
      "files": [
        "!**/node_modules/uiohook-napi/prebuilds/!(darwin-x64|darwin-arm64)/**"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "GlintRec uses the camera for the webcam bubble.",
        "NSMicrophoneUsageDescription": "GlintRec uses the microphone to record audio.",
        "NSScreenCaptureUsageDescription": "GlintRec records your screen."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "assets/icon.png",
      "files": [
        "!**/node_modules/uiohook-napi/prebuilds/!(linux-x64)/**"
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
